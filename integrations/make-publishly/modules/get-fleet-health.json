{
  "name": "getFleetHealth",
  "label": "Get fleet health",
  "description": "Returns connection colors, queues, confirmed posting success, token health, and platform truth.",
  "type": "action",
  "connection": "publishly",
  "mappableParameters": [
    {
      "name": "windowDays",
      "label": "Outcome window",
      "type": "select",
      "required": true,
      "default": "30",
      "options": [
        { "label": "7 days", "value": "7" },
        { "label": "30 days", "value": "30" },
        { "label": "90 days", "value": "90" }
      ]
    },
    {
      "name": "groupId",
      "label": "Account group ID",
      "type": "text",
      "advanced": true
    },
    {
      "name": "tagId",
      "label": "Account tag ID",
      "type": "text",
      "advanced": true
    },
    {
      "name": "color",
      "label": "Health color",
      "type": "select",
      "advanced": true,
      "options": [
        { "label": "All", "value": "" },
        { "label": "Green", "value": "green" },
        { "label": "Yellow", "value": "yellow" },
        { "label": "Red", "value": "red" }
      ]
    }
  ],
  "communication": {
    "url": "/fleet-health",
    "method": "GET",
    "qs": {
      "windowDays": "{{parameters.windowDays}}",
      "groupId": "{{parameters.groupId}}",
      "tagId": "{{parameters.tagId}}",
      "color": "{{parameters.color}}"
    },
    "response": {
      "output": "{{body}}"
    }
  },
  "interface": [
    { "name": "generatedAt", "label": "Generated at", "type": "date" },
    { "name": "windowDays", "label": "Window days", "type": "integer" },
    { "name": "summary", "label": "Fleet summary", "type": "collection" },
    { "name": "facets", "label": "Groups and tags", "type": "collection" },
    { "name": "rows", "label": "Connections", "type": "array" }
  ]
}
