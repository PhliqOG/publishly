{
  "name": "publishNow",
  "label": "Publish a post now",
  "description": "Creates an idempotent publish-now request. A workflow retry with the same key and body cannot double-post.",
  "type": "action",
  "connection": "publishly",
  "mappableParameters": [
    {
      "name": "idempotencyKey",
      "label": "Idempotency key",
      "type": "text",
      "required": true,
      "help": "Stable 8-200 character key for this creation intent. Reuse it when Make retries the same bundle."
    },
    {
      "name": "shortLink",
      "label": "Shorten links",
      "type": "boolean",
      "required": true,
      "default": false
    },
    {
      "name": "tags",
      "label": "Post tags JSON",
      "type": "json",
      "required": true,
      "default": "[]"
    },
    {
      "name": "posts",
      "label": "Destination posts JSON",
      "type": "json",
      "required": true,
      "help": "A non-empty array using the Publishly public-v1 post shape."
    }
  ],
  "communication": {
    "url": "/posts",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json",
      "Idempotency-Key": "{{parameters.idempotencyKey}}"
    },
    "body": {
      "type": "now",
      "date": "{{now}}",
      "shortLink": "{{parameters.shortLink}}",
      "tags": "{{parameters.tags}}",
      "posts": "{{parameters.posts}}"
    },
    "response": {
      "output": {
        "result": "{{body}}",
        "idempotencyReplayed": "{{lower(ifempty(headers.`idempotency-replayed`, headers.`Idempotency-Replayed`)) == 'true'}}"
      }
    }
  },
  "interface": [
    {
      "name": "result",
      "label": "Created posts",
      "type": "array"
    },
    {
      "name": "idempotencyReplayed",
      "label": "Idempotency replayed",
      "type": "boolean"
    }
  ]
}
