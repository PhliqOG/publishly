# ============================================================================
# Publishly configuration reference
# Copy to .env and fill in. Groups marked OPTIONAL can stay empty - the app
# boots credential-independent and shows unconfigured providers as disabled.
# Set CONFIG_STRICT=true in production so misconfiguration refuses boot.
# ============================================================================

# === Required core =========================================================
# Dev defaults below match docker-compose.publishly.dev.yaml exactly.
DATABASE_URL="postgresql://publishly-local:publishly-local-pwd@localhost:5433/publishly-db-local"
REDIS_URL="redis://localhost:6380"
# >=32 random characters; never a guessable phrase (checked at boot)
JWT_SECRET=""
# Dedicated key for at-rest token encryption (falls back to JWT_SECRET with a
# warning). Rotating it invalidates sealed tokens - see docs/SECURITY.md.
ENCRYPTION_SECRET=""

# === URLs (exact public URLs, no trailing slash) ===========================
FRONTEND_URL="http://localhost:4200"
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"
BACKEND_INTERNAL_URL="http://localhost:3000"
MAIN_URL="http://localhost:4200"

# === Temporal ==============================================================
TEMPORAL_ADDRESS="localhost:7233"
# TEMPORAL_NAMESPACE="default"
# TEMPORAL_TLS="false"
# TEMPORAL_API_KEY=""            # Temporal Cloud only
# ORCHESTRATOR_PORT=3002
# WORKER_DEFAULT_ACTIVITY_CONCURRENCY=32
# WORKER_DEFAULT_WORKFLOW_CONCURRENCY=8
# WORKER_ACTIVITY_POLLS=4
# WORKER_WORKFLOW_POLLS=4
# ORCHESTRATOR_HEARTBEAT_MAX_AGE_SECONDS=180

# === Application behaviour =================================================
IS_GENERAL="true"                 # required
NX_ADD_PLUGINS=false
# RUN_CRON="true"                 # exactly ONE backend instance in prod
# DISABLE_REGISTRATION="false"
# CONFIG_STRICT="true"            # prod: fail boot on config issues
API_LIMIT=30                      # public API requests/hour/org/bucket
# Temporary migration escape hatch only; plaintext legacy workspace keys stay
# rejected unless explicitly enabled. New deployments must leave this false.
ALLOW_LEGACY_API_KEYS="false"
# RESTRICT_UPLOAD_DOMAINS=""
# DISABLE_IMAGE_COMPRESSION="false"
# DISABLE_SSRF_PROTECTION="false" # only on fully trusted private networks
# NOT_SECURED="false"             # DEV ONLY - relaxes cookie security
# DISALLOW_PLUS=""                # block plus-addressed signup emails

# === Branding (single-source rename) =======================================
# NEXT_PUBLIC_BRAND_NAME="Publishly"
# NEXT_PUBLIC_SOURCE_URL=""       # public mirror for the AGPL /source page
# NEXT_PUBLIC_SUPPORT_EMAIL=""
# Optional server-only recipient for agency-directory review requests.
# AGENCY_REVIEW_EMAIL=""
# NEXT_PUBLIC_PRIVACY_EMAIL=""
# NEXT_PUBLIC_LEGAL_ENTITY_NAME=""
# NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=""
# NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE="2026-08-11"
# NEXT_PUBLIC_GOVERNING_LAW=""

# === Billing: Stripe (all-or-nothing group) ================================
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_SIGNING_KEY=""             # webhook endpoint <backend>/stripe
STRIPE_SIGNING_KEY_CONNECT=""
FEE_AMOUNT=0.05
# STRIPE_DISCOUNT_ID=""
# Entitlement overrides (JSON, validated at boot), e.g. {"PRO":{"channel":50}}
# PRICING_OVERRIDES_JSON=""

# === Storage ===============================================================
STORAGE_PROVIDER="local"          # local | s3 | cloudflare (legacy R2 alias)
UPLOAD_DIRECTORY=""               # absolute path when STORAGE_PROVIDER=local
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=""
MOBILE_APP_SCHEME="publishly://auth/callback" # also defines OAuth return scheme
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_ACCESS_KEY=""
# CLOUDFLARE_SECRET_ACCESS_KEY=""
# CLOUDFLARE_BUCKETNAME=""
# CLOUDFLARE_BUCKET_URL=""
# CLOUDFLARE_REGION="auto"
# Generic S3-compatible storage (AWS, R2, MinIO, Backblaze, etc.):
# S3_ENDPOINT="https://s3.us-east-1.amazonaws.com" # omit for standard AWS
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET="publishly-media"
# S3_PUBLIC_URL="https://media.example.com"
# S3_FORCE_PATH_STYLE="false"     # true for MinIO and some compatible hosts
# Bounded server-side URL imports; larger assets use signed multipart upload.
# REMOTE_MEDIA_MAX_BYTES=104857600
# MEDIA_DELETE_RETENTION_DAYS=30 # soft-deleted files retained before cleanup

# === Email (activation, resets, digests) ===================================
# EMAIL_PROVIDER="resend"         # resend | nodemailer; unset = no emails,
#                                 # accounts activate without verification
# RESEND_API_KEY=""
# EMAIL_FROM_ADDRESS=""
# EMAIL_FROM_NAME=""
# SMTP (EMAIL_PROVIDER=nodemailer):
# EMAIL_HOST=""
# EMAIL_PORT="465"
# EMAIL_SECURE="true"
# EMAIL_USER=""
# EMAIL_PASS=""

# === Social providers (each group unlocks its connect flow) ================
# Meta - Facebook Pages + Instagram (Business):
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
META_GRAPH_VERSION="v25.0"       # pin; upgrade only after provider canaries
META_WEBHOOK_VERIFY_TOKEN=""      # unique random value, 32+ characters
# Instagram standalone app (Instagram Login):
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
X_API_KEY=""
X_API_SECRET=""
# X_URL=""
# DISABLE_X_ANALYTICS=""
# STRIP_LINKS_FROM_X_POSTS=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
# Mastodon registers a scoped OAuth client dynamically on each user-selected
# public instance; no global Mastodon client secret is needed.
# Bluesky needs no server keys (per-user app passwords).
GOOGLE_GMB_CLIENT_ID=""
GOOGLE_GMB_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""
SLACK_ID=""
SLACK_SECRET=""
SLACK_SIGNING_SECRET=""
TELEGRAM_TOKEN=""
TELEGRAM_BOT_NAME=""
# NEYNAR_CLIENT_ID=""             # Farcaster
# NEYNAR_SECRET_KEY=""
# VK_ID=""
# KICK_CLIENT_ID=""
# KICK_SECRET=""
# TWITCH_CLIENT_ID=""
# TWITCH_CLIENT_SECRET=""
# DRIBBBLE_CLIENT_ID=""
# DRIBBBLE_CLIENT_SECRET=""
# TUMBLR_CLIENT_ID=""
# TUMBLR_CLIENT_SECRET=""
# MEWE_HOST=""
# MEWE_APP_ID=""
# MEWE_API_KEY=""
# WHOP_CLIENT_ID=""
# Wordpress/Lemmy/Medium/Dev.to/Hashnode/Nostr/Listmonk: per-user credentials
# entered at connect time - no server keys.

# === Sign-in providers (dashboard SSO) =====================================
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
