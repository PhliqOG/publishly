# === Development & testing only ============================================
# Bulk Scheduler is fail-closed. Keep the global and tuple kill switches after
# release. Canary mode is only for designated provider test accounts.
# PUBLISHLY_BUILD_REVISION="" # immutable git SHA or image digest exposed only as canary evidence
# BULK_SCHEDULER_KILL_ALL="true"
# BULK_SCHEDULER_CANARY_MODE="false"
# BULK_SCHEDULER_CANARY_TUPLES=""
# Comma-separated Integration IDs owned by Publishly and designated only for
# controlled Stage 8 canaries. Customer account IDs must never be placed here.
# BULK_SCHEDULER_CANARY_INTEGRATIONS=""
# Keep false until migrations, reservation authority, and Stage 7 suites pass.
# BULK_SCHEDULER_MATERIALIZER_ENABLED="false"
# BULK_SCHEDULER_MATERIALIZE_HORIZON_HOURS="24"
# BULK_SCHEDULER_MATERIALIZE_BATCH="100"
# BULK_SCHEDULER_MATERIALIZE_LEASE_SECONDS="600"
# PROVIDER_MEDIA_BASE_URL="https://api.example.com"
# BULK_PRIVATE_INTERNAL_TOKEN="" # >=32 random characters; backend + orchestrator only
# BULK_PRIVATE_STORAGE_PROVIDER="local" # local, s3, or cloudflare
# BULK_PRIVATE_UPLOAD_DIRECTORY="C:/absolute/non-public/publishly-media"
# BULK_PRIVATE_S3_BUCKET="" # required for s3/cloudflare; must not be public bucket
# BULK_PRIVATE_S3_ENDPOINT=""
# BULK_PRIVATE_S3_REGION="us-east-1"
# BULK_PRIVATE_S3_ACCESS_KEY_ID=""
# BULK_PRIVATE_S3_SECRET_ACCESS_KEY=""
# Tuple-specific BULK_SCHEDULER_KILL_* names are generated in
# docs/BULK_SCHEDULER_CAPABILITIES.md from the capability matrix.

# Calendar reservation rollout: shadow first, enforce only after every tenant's
# fixed backfill watermark verifies with no unexplained mismatches.
# CALENDAR_RESERVATION_KILL_ALL="false"
# CALENDAR_RESERVATION_SHADOW_ENABLED="true"
# CALENDAR_RESERVATION_ENFORCEMENT="false"
# Optional comma-separated tenant IDs for a bounded enforcement rollout. Empty
# means every verified/promoted tenant when enforcement is true.
# CALENDAR_RESERVATION_ENFORCED_TENANTS=""

# Registers the sandbox "Test Provider" channel (full pipeline, publishes
# nowhere). NEVER enable in production.
# ENABLE_TEST_PROVIDER="true"
# TEST_PROVIDER_MODE=""           # "pending" exercises finalize path
# TEST_PROVIDER_FAIL_TIMES="0"    # simulate transient failures
# TEST_PROVIDER_AMBIGUOUS_FAIL_TIMES="0" # side effect then failure; must never auto-replay
# TEST_PROVIDER_SINK=".building/logs/testprovider-sink.jsonl" # exactly-once assertion journal
# EXTENSION_ID=""
# NEXT_PUBLIC_CHROME_EXTENSION_URL="" # required with EXTENSION_ID for optional extension channels
