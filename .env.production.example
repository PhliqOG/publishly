# Copy to .env.production, keep it out of source control, then replace every
# CHANGE_ME value. Use: docker compose --env-file .env.production -f deploy/compose.production.yaml up -d
PUBLISHLY_DOMAIN=publishlyapi.com
ACME_EMAIL=ops@example.com
# Direct-origin defaults. scripts/deploy-vps.ps1 switches these to private
# HTTP/loopback automatically when -CloudflareTunnelCredentials is supplied.
COMPOSE_PROFILES=
PUBLISHLY_BIND_ADDRESS=0.0.0.0
PUBLISHLY_CADDY_ADDRESS=publishlyapi.com
PUBLISHLY_CADDY_WWW_ADDRESS=www.publishlyapi.com
CLOUDFLARE_TUNNEL_ID=
PUBLISHLY_IMAGE_TAG=CHANGE_ME_IMMUTABLE_RELEASE_TAG
NEXT_PUBLIC_BRAND_NAME=Publishly
NEXT_PUBLIC_SUPPORT_EMAIL=support@publish.example.com
AGENCY_REVIEW_EMAIL=review@publish.example.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@publish.example.com
NEXT_PUBLIC_LEGAL_ENTITY_NAME=CHANGE_ME_REGISTERED_LEGAL_ENTITY
NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=CHANGE_ME_FULL_POSTAL_ADDRESS
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=2026-08-11
NEXT_PUBLIC_GOVERNING_LAW=CHANGE_ME_STATE_OR_COUNTRY
# Public mirror/archive of the exact deployed revision for AGPL-3.0 section 13.
NEXT_PUBLIC_SOURCE_URL=https://github.com/CHANGE_ME_ORG/publishly

DATABASE_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
TEMPORAL_DATABASE_PASSWORD=CHANGE_ME_RANDOM_TEMPORAL_PASSWORD
DATABASE_URL=postgresql://publishly:CHANGE_ME_RANDOM_DATABASE_PASSWORD@postgres:5432/publishly
REDIS_URL=redis://redis:6379
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
WORKER_CONCURRENCY_DIVIDER=1
WORKER_DEFAULT_ACTIVITY_CONCURRENCY=32
WORKER_DEFAULT_WORKFLOW_CONCURRENCY=8
WORKER_ACTIVITY_POLLS=4
WORKER_WORKFLOW_POLLS=4
ORCHESTRATOR_HEARTBEAT_MAX_AGE_SECONDS=180

MAIN_URL=https://publishlyapi.com
FRONTEND_URL=https://publishlyapi.com
NEXT_PUBLIC_BACKEND_URL=https://publishlyapi.com/api
BACKEND_INTERNAL_URL=http://backend:3000
MOBILE_APP_SCHEME=publishly://auth/callback
JWT_SECRET=CHANGE_ME_64_PLUS_RANDOM_CHARACTERS
ENCRYPTION_SECRET=CHANGE_ME_DIFFERENT_64_PLUS_RANDOM_CHARACTERS
CONFIG_STRICT=true
IS_GENERAL=true
DISABLE_REGISTRATION=false
NOT_SECURED=
ALLOW_LEGACY_API_KEYS=false

STORAGE_PROVIDER=s3
# The buckets and custom hostname already exist in the Publishly Cloudflare
# account. Replace only the account id and scoped R2 S3 credentials.
S3_ENDPOINT=https://CHANGE_ME_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=CHANGE_ME_R2_PUBLIC_MEDIA_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=CHANGE_ME_R2_PUBLIC_MEDIA_SECRET_ACCESS_KEY
S3_BUCKET=publishly-media-production
S3_PUBLIC_URL=https://media.publishlyapi.com
S3_FORCE_PATH_STYLE=false
REMOTE_MEDIA_MAX_BYTES=104857600
MEDIA_DELETE_RETENTION_DAYS=30

# Bulk Scheduler remains customer-disabled until exact tuples are certified.
# Canary mode is restricted to designated provider test accounts.
PUBLISHLY_BUILD_REVISION=CHANGE_ME_GIT_SHA_OR_IMAGE_DIGEST
BULK_SCHEDULER_KILL_ALL=false
BULK_SCHEDULER_CANARY_MODE=false
BULK_SCHEDULER_CANARY_TUPLES=
BULK_SCHEDULER_CANARY_INTEGRATIONS=
BULK_SCHEDULER_MATERIALIZER_ENABLED=false
BULK_SCHEDULER_MATERIALIZE_HORIZON_HOURS=24
BULK_SCHEDULER_MATERIALIZE_BATCH=100
BULK_SCHEDULER_MATERIALIZE_LEASE_SECONDS=600
PROVIDER_MEDIA_BASE_URL=https://publishlyapi.com/api
BULK_PRIVATE_INTERNAL_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
BULK_PRIVATE_STORAGE_PROVIDER=s3
BULK_PRIVATE_S3_ENDPOINT=https://CHANGE_ME_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
BULK_PRIVATE_S3_REGION=auto
BULK_PRIVATE_S3_ACCESS_KEY_ID=CHANGE_ME_R2_PRIVATE_BULK_ACCESS_KEY_ID
BULK_PRIVATE_S3_SECRET_ACCESS_KEY=CHANGE_ME_R2_PRIVATE_BULK_SECRET_ACCESS_KEY
BULK_PRIVATE_S3_BUCKET=publishly-bulk-private-production
BULK_PRIVATE_S3_FORCE_PATH_STYLE=false
CALENDAR_RESERVATION_KILL_ALL=false
CALENDAR_RESERVATION_SHADOW_ENABLED=true
CALENDAR_RESERVATION_ENFORCEMENT=false
CALENDAR_RESERVATION_ENFORCED_TENANTS=

EMAIL_PROVIDER=resend
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM_ADDRESS=hello@publish.example.com
EMAIL_FROM_NAME=Publishly

# The public pricing page is live, so production billing must be live too.
STRIPE_PUBLISHABLE_KEY=CHANGE_ME_PK_LIVE
STRIPE_SECRET_KEY=CHANGE_ME_SK_LIVE
STRIPE_SIGNING_KEY=CHANGE_ME_WHSEC

# First official launch: Instagram for professional brands/businesses and
# TikTok Content Posting. The other adapters remain available for later staged
# approvals; add each provider here only when its production credential and
# end-to-end canary are ready.
PUBLISHLY_REQUIRED_PROVIDERS=instagram,tiktok
META_GRAPH_VERSION=v25.0
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_RANDOM_32_PLUS_CHARACTERS
FACEBOOK_APP_ID=CHANGE_ME
FACEBOOK_APP_SECRET=CHANGE_ME
TIKTOK_CLIENT_ID=CHANGE_ME
TIKTOK_CLIENT_SECRET=CHANGE_ME
YOUTUBE_CLIENT_ID=CHANGE_ME
YOUTUBE_CLIENT_SECRET=CHANGE_ME
X_API_KEY=CHANGE_ME
X_API_SECRET=CHANGE_ME
THREADS_APP_ID=CHANGE_ME
THREADS_APP_SECRET=CHANGE_ME
LINKEDIN_CLIENT_ID=CHANGE_ME
LINKEDIN_CLIENT_SECRET=CHANGE_ME
PINTEREST_CLIENT_ID=CHANGE_ME
PINTEREST_CLIENT_SECRET=CHANGE_ME
# After adding S3_PUBLIC_URL (or the Cloudflare bucket prefix) to TikTok URL
# properties and completing verification, change this acknowledgement to true.
TIKTOK_MEDIA_URL_PREFIX_VERIFIED=false
# Bluesky uses a per-user App Password. Mastodon dynamically registers a
# per-instance OAuth app. Neither needs an operator-owned app secret.
# Optional browser-extension channels remain disabled unless both values point
# to a separately reviewed Publishly extension release.
# EXTENSION_ID=
# NEXT_PUBLIC_CHROME_EXTENSION_URL=
